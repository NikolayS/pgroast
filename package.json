{
  "name": "pgroast",
  "version": "0.4.2",
  "description": "AI-assisted Postgres patch roasting: idea scrutiny against 2,547 precedents, code diffs, meson builds, tests, and live SQL stress.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NikolayS/pgroast.git"
  },
  "homepage": "https://github.com/NikolayS/pgroast#readme",
  "bugs": {
    "url": "https://github.com/NikolayS/pgroast/issues"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "pgsql-hackers",
    "commitfest",
    "review"
  ],
  "type": "module",
  "bin": {
    "pgroast": "bin/pgroast.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "prompts/",
    "skills/",
    "invariants/",
    "sql/",
    "data/precedents.sql.gz",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.5",
    "node": ">=18"
  },
  "scripts": {
    "corpus:build": "bun run src/corpus/cli.ts build",
    "corpus:search": "bun run src/corpus/cli.ts search",
    "corpus:selftest": "bun run src/corpus/cli.ts selftest",
    "corpus:stats": "bun run src/corpus/cli.ts stats",
    "roast": "bun run src/cli.ts",
    "app:local": "bun run apps/local/src/server.ts",
    "app:web": "bun run apps/web/src/server.ts",
    "web:mint-token": "bun run apps/web/src/mint-token.ts",
    "web:sync-hackers": "bun run apps/web/src/sync-hackers.ts",
    "web:sync-lists": "bun run apps/web/src/sync-lists.ts",
    "web:sync-cf": "bun run apps/web/src/sync-cf.ts",
    "test": "bun test ./test/",
    "test:all": "bun test ./test/ && bun test ./apps/local/test/ && bun test ./apps/web/test/",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc --noEmit && tsc --noEmit -p apps/local/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "1.3.5",
    "typescript": "^5.9.0"
  }
}
