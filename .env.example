# PostgreSQL connections (PG 19 recommended; adjust port if running alongside PG 18)
PGROAST_DSN=postgres://localhost:5439/pgroast
PGROAST_DATABASE_URL=postgres://localhost:5439/pgroast_app
PGROAST_WEB_DATABASE_URL=postgres://localhost:5439/pgroast_web

# Public Companion Hub URL (used by Personal Backoffice for publishing & cross-links)
PGROAST_PUBLIC_HUB_URL=https://pgroast.postgres.ai

# Public App settings (only needed if self-hosting apps/web)
PGROAST_WEB_ORIGIN=https://pgroast.postgres.ai
PGROAST_WEB_DEV_AUTH=0
# PGROAST_WEB_ADMIN_SECRET=change-me-for-remote-invite-minting
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
